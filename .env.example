# Copiază în .env (ignorat de git). `./gradlew :app:bootRun` încarcă .env automat; în IDE setezi aceleași variabile la Run Configuration.
POSTGRES_URL=jdbc:postgresql://localhost:5432/aradexperience
POSTGRES_USER=arad
POSTGRES_PASSWORD=arad

JWT_SECRET=schimba-ma-cu-un-string-random-de-minim-32-caractere
JWT_EXPIRATION_HOURS=24

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-5-5

CORS_ORIGINS=http://localhost:5173
SPRING_PROFILES_ACTIVE=default

# Poze (media): gol = pe disc în MEDIA_LOCAL_DIR; în AWS = bucket-ul S3 (Terraform), acces prin rolul task-ului
MEDIA_BUCKET=
MEDIA_LOCAL_DIR=uploads
MEDIA_PUBLIC_URL=
MEDIA_AUTO_SYNC=true
