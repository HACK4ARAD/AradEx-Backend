# Copiază în .env (ignorat de git). `./gradlew :app:bootRun` încarcă .env automat; în IDE setezi aceleași variabile la Run Configuration.
POSTGRES_URL=jdbc:postgresql://localhost:5432/aradexperience
POSTGRES_USER=arad
POSTGRES_PASSWORD=arad

JWT_SECRET=schimba-ma-cu-un-string-random-de-minim-32-caractere
JWT_EXPIRATION_HOURS=24

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-5-5

CORS_ORIGINS=http://localhost:5173
SPRING_PROFILES_ACTIVE=default

# Poze (media): gol = pe disc în MEDIA_LOCAL_DIR; în AWS = bucket-ul S3 (Terraform), acces prin rolul task-ului
MEDIA_BUCKET=
MEDIA_LOCAL_DIR=uploads
MEDIA_PUBLIC_URL=
MEDIA_AUTO_SYNC=true
# Plata biletelor cu Stripe în modul de test (cont Stripe de test, chei din Dashboard → Developers → API keys, cu „Test mode” pornit).
# Doar sk_test_… / pk_test_…; goale (sau chei live) = plata demonstrativă.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# T25: opțional — semnătura webhook-ului Stripe (whsec_…); local: stripe listen --forward-to localhost:8080/api/v1/payments/stripe/webhook
STRIPE_WEBHOOK_SECRET=
